# --- Claude (the brain of Mikee) ---
ANTHROPIC_API_KEY=

# --- App security ---
# 32+ random chars. Generate: openssl rand -hex 32
SESSION_SECRET=
# 32 bytes hex, encrypts stored tokens. Generate: openssl rand -hex 32
MIKEE_ENCRYPTION_KEY=
# Public URL of the deployment (used for the Facebook login redirect)
APP_URL=http://localhost:3000
# Protects the scheduled check-in endpoint (a Railway cron service calls it with this Bearer token)
CRON_SECRET=

# --- Database ---
# Railway Postgres connection string. Leave empty for local dev: an embedded DB is stored in ./.data
DATABASE_URL=

# --- Meta app ---
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v26.0
# Optional: Facebook Login for Business configuration id
META_LOGIN_CONFIG_ID=

# --- Higgsfield (optional, media generation via its MCP server) ---
HIGGSFIELD_MCP_URL=
HIGGSFIELD_MCP_TOKEN=
