# --- Claude (the brain of Mikee) ---
ANTHROPIC_API_KEY=
# Models. Two tiers: main (default claude-sonnet-5-5) and light (default claude-haiku-5-5).
# Roles default to light, except the media buyer and the analyst (main). Move roles for a comparison:
# MIKEE_TIERS=mikee=main,creative=main   (roles: mikee, media_buyer, analyst, copywriter, social, creative, video_editor)
MIKEE_MODEL_MAIN=
MIKEE_MODEL_LIGHT=
MIKEE_TIERS=
# Per-task limits: time in ms and AI cost in USD (defaults 600000 and 2)
MIKEE_TASK_MAX_MS=
MIKEE_TASK_MAX_USD=

# --- App security ---
# 32+ random chars. Generate: openssl rand -hex 32
SESSION_SECRET=
# 32 bytes hex, encrypts stored tokens. Generate: openssl rand -hex 32
MIKEE_ENCRYPTION_KEY=
# Public URL of the deployment (used for the Facebook login redirect)
APP_URL=http://localhost:3000
# The marketing site's address (the pages in src/app/site). Requests on this host show the site; account pages
# move to APP_URL. Leave empty locally: the site is then at /site.
SITE_URL=
# Optional: where to post a note when someone books an intro meeting on the site (Slack-style {"text"} webhook).
# Falls back to SUPPORT_WEBHOOK_URL. List the meetings with `npm run meetings`.
SITE_WEBHOOK_URL=
# Protects the scheduled check-in endpoint (a Railway cron service calls it with this Bearer token)
CRON_SECRET=

# --- Database ---
# Railway Postgres connection string. Leave empty for local dev: an embedded DB is stored in ./.data
DATABASE_URL=

# --- Meta app ---
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v26.0
# Required: the Facebook Login for Business configuration id (App Dashboard > Facebook Login for Business >
# Configurations). The login dialog sends it instead of a permission list. Recommended: a system-user token
# configuration (60 days; Mikee renews it automatically).
META_LOGIN_CONFIG_ID=
# Instagram messages webhook (Meta App Dashboard > Webhooks > Instagram, field "messages").
# Callback URL: <APP_URL>/api/meta/webhook. Any long random string, the same one typed in the dashboard:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
META_WEBHOOK_VERIFY_TOKEN=

# --- Higgsfield (optional, media generation via its MCP server) ---
HIGGSFIELD_MCP_URL=
HIGGSFIELD_MCP_TOKEN=

# File storage (S3-compatible bucket: AWS S3, Cloudflare R2, Railway buckets). Without it files stay in the database (max 50MB each).
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Railway buckets: S3_ENDPOINT=https://storage.railway.app (virtual-hosted, chosen automatically).
# Set S3_URL_STYLE=path or virtual only if the bucket's Credentials tab says otherwise.
# S3_URL_STYLE=

# Google Drive import (OAuth client "Web application", redirect {APP_URL}/api/google/callback, scope drive.file)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_API_KEY=
GOOGLE_APP_ID=

# Help & support
SUPPORT_EMAIL=
SUPPORT_WHATSAPP=
SUPPORT_WEBHOOK_URL=

# Plan for businesses without one: ai_299 | ai_499 (the old starter, growth and pro still work, on the nearest AI plan)
MIKEE_DEFAULT_PLAN=ai_499

# First run only: creates the business and its owner when there are no users yet. Remove the password after signing in.
MIKEE_BUSINESS_NAME=
MIKEE_OWNER_NAME=
MIKEE_OWNER_EMAIL=
MIKEE_OWNER_PASSWORD=

# Sign-up at /signup (username, email, password) is open; "closed" turns it off. Limits: 20 per network per
# hour, 50 per day, and MIKEE_SIGNUP_DAILY_CAP new accounts per day overall (default 50).
MIKEE_SIGNUP=
MIKEE_SIGNUP_DAILY_CAP=

# Branded videos: the HyperFrames render worker (render-worker/, a separate service on the private network).
# RENDER_URL=http://render-worker.railway.internal:8080
RENDER_URL=
RENDER_SECRET=

# Owner password reset (or recreate a lost owner): set both, redeploy, sign in, then delete both.
MIKEE_RESET_EMAIL=
MIKEE_RESET_PASSWORD=
# Optional, with the two above: also set the sign-in username (e.g. rachel)
MIKEE_RESET_USERNAME=
# How many days a sign-in lasts (default 60)
SESSION_DAYS=

# Usage quota (src/lib/credits.ts, src/lib/plans.ts). One credit = MIKEE_CREDIT_USD of our cost, in every plan.
# MIKEE_CREDIT_USD=0.01
# Credits included per billing cycle in each AI plan.
# MIKEE_PLAN_CREDITS={"ai_299":2700,"ai_499":6700}
# What one Higgsfield credit costs us on our Higgsfield plan.
# MIKEE_HIGGSFIELD_CREDIT_USD=0.07
# Credits set aside when a conversation turn starts (its real cost is charged against them).
# MIKEE_TURN_HOLD_CREDITS=40
# How long bought credits stay valid, in months (0 = no expiry).
# MIKEE_PURCHASED_CREDITS_MONTHS=12
