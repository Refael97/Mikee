  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "הפעולה הראשית היחידה באזור: אישור הצעה, שיחה חדשה, חיבור.",
      "html": "<div dir=\"rtl\"><button class=\"ds-btn ds-btn-primary\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 6 9 17l-5-5\"/></svg>לאשר ולהעלות</button></div>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;height:36px;padding:0 14px;border-radius:6px;font-family:Heebo,sans-serif;font-size:15px;font-weight:500;white-space:nowrap;border:1px solid transparent;cursor:pointer;transition:background-color 120ms ease,border-color 120ms ease,box-shadow 120ms ease,color 120ms ease;}.ds-btn:focus-visible{outline:none;box-shadow:var(--ring,0 0 0 4px rgba(75,63,224,.18));}.ds-btn:disabled{opacity:.45;pointer-events:none;}.ds-btn-primary{background:var(--brand,#4b3fe0);color:var(--on-brand,#fff);box-shadow:0 1px 1px rgba(26,31,54,.12),inset 0 -1px 0 rgba(0,0,0,.12);}.ds-btn-primary:hover{background:var(--brand-hover,#3e33c4);}"
    },
    {
      "name": "Quiet Button",
      "kind": "button",
      "refersTo": "button-quiet",
      "description": "הפעולה המשנית לצד הראשי, ופעולות בכותרת עמוד.",
      "html": "<div dir=\"rtl\"><button class=\"ds-btn ds-btn-quiet\">לא הפעם</button></div>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;height:36px;padding:0 14px;border-radius:6px;font-family:Heebo,sans-serif;font-size:15px;font-weight:500;white-space:nowrap;border:1px solid transparent;cursor:pointer;transition:background-color 120ms ease,border-color 120ms ease,box-shadow 120ms ease,color 120ms ease;}.ds-btn:focus-visible{outline:none;box-shadow:var(--ring,0 0 0 4px rgba(75,63,224,.18));}.ds-btn:disabled{opacity:.45;pointer-events:none;}.ds-btn-quiet{background:var(--surface,#fff);border-color:var(--line-strong,#d5dbe1);color:var(--ink,#1a1f36);box-shadow:0 1px 1px rgba(26,31,54,.05);}.ds-btn-quiet:hover{border-color:var(--ink-3,#8792a2);}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "כפתורי אייקון וטקסט בלי רקע: תפריט, עזרה, סגירה.",
      "html": "<div dir=\"rtl\"><button class=\"ds-btn ds-btn-ghost\">ביטול</button></div>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;height:36px;padding:0 14px;border-radius:6px;font-family:Heebo,sans-serif;font-size:15px;font-weight:500;white-space:nowrap;border:1px solid transparent;cursor:pointer;transition:background-color 120ms ease,border-color 120ms ease,box-shadow 120ms ease,color 120ms ease;}.ds-btn:focus-visible{outline:none;box-shadow:var(--ring,0 0 0 4px rgba(75,63,224,.18));}.ds-btn:disabled{opacity:.45;pointer-events:none;}.ds-btn-ghost{background:transparent;color:var(--ink-2,#545969);}.ds-btn-ghost:hover{background:var(--surface-2,#f5f6f8);color:var(--ink,#1a1f36);}"
    },
    {
      "name": "Field",
      "kind": "input",
      "refersTo": "field",
      "description": "שדה טקסט: גבול line-strong, פוקוס בגבול סגול וטבעת.",
      "html": "<div dir=\"rtl\"><input class=\"ds-field\" placeholder=\"שם העסק\"></div>",
      "css": ".ds-field{width:260px;height:38px;background:var(--surface,#fff);color:var(--ink,#1a1f36);border:1px solid var(--line-strong,#d5dbe1);border-radius:6px;padding:0 11px;font-family:Heebo,sans-serif;font-size:15px;outline:none;box-shadow:0 1px 1px rgba(26,31,54,.04);transition:border-color 120ms ease,box-shadow 120ms ease;caret-color:var(--brand,#4b3fe0);}.ds-field:hover{border-color:var(--ink-3,#8792a2);}.ds-field:focus{border-color:var(--brand,#4b3fe0);box-shadow:var(--ring,0 0 0 4px rgba(75,63,224,.18));}.ds-field::placeholder{color:var(--ink-3,#8792a2);}"
    },
    {
      "name": "Status Tags",
      "kind": "chip",
      "refersTo": "tag",
      "description": "סטטוס כמלבן של 22px עם פינה של 4px, טקסט על גוון בהיר מאותו צבע. אף פעם לא גלולה.",
      "html": "<div dir=\"rtl\" class=\"ds-row\"><span class=\"ds-tag ds-tag-brand\">מחכה לך</span><span class=\"ds-tag ds-tag-good\">עלה לאוויר</span><span class=\"ds-tag ds-tag-warn\">לבדוק</span><span class=\"ds-tag ds-tag-bad\">לא הצליח</span><span class=\"ds-tag ds-tag-quiet\">בוטל</span></div>",
      "css": ".ds-row{display:flex;gap:8px;flex-wrap:wrap;}.ds-tag{display:inline-flex;align-items:center;gap:4px;height:22px;padding:0 7px;border-radius:4px;font-family:Heebo,sans-serif;font-size:13px;font-weight:500;line-height:1;white-space:nowrap;background:var(--surface-2,#f5f6f8);color:var(--ink-2,#545969);}.ds-tag-brand{background:var(--brand-tint,#efeefd);color:var(--brand,#4b3fe0);}.ds-tag-good{background:var(--good-tint,#e3f6e9);color:var(--good,#0f6b3a);}.ds-tag-warn{background:var(--warn-tint,#fdf1d6);color:var(--warn,#9a4b00);}.ds-tag-bad{background:var(--bad-tint,#fde8ee);color:var(--bad,#b3093c);}.ds-tag-quiet{color:var(--ink-3,#8792a2);}"
    },
    {
